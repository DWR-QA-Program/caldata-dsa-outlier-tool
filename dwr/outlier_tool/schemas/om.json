{
    "name": "O&M (.PRN)",
    "description": "Data dictionary provided by Daniel Wisheropp from the O&M team",
    "file_format_description": "This is a comma-separated .PRN or .csv file without any header row. 14 columns are expected, though data columns can be null if a station doesn't collect a given dimension.",
    "columns": [
        {
            "name": "SITE_NAME",
            "type": "str",
            "description": "Three character code for this station"
        },
        {
            "name": "DATETIME",
            "type": "datetime",
            "description": "Date and time of the record in the format 'yyyy-mm-dd hh:mm:ss"
        },
        {
            "name": "SPECIFIC_CONDUCTANCE",
            "type": "float",
            "units": "uS/cm",
            "min": 0
        },
        {
            "name": "WATER_TEMPERATURE",
            "type": "float",
            "units": "°C",
            "min": 0,
            "max": 100
        },
        {
            "name": "TURBIDITY",
            "type": "float",
            "units": "NTU",
            "min": 0
        },
        {
            "name": "pH",
            "type": "float",
            "min": 0,
            "max": 14
        },
        {
            "name": "FLUORESCENCE",
            "type": "float",
            "units": "RFU",
            "min": 0
        },
        {
            "name": "WIND_SPEED",
            "type": "float",
            "units": "MPH",
            "min": 0
        },
        {
            "name": "WIND_DIRECTION",
            "type": "float",
            "units": "Degrees",
            "min": 0,
            "max": 360
        },
        {
            "name": "AIR_TEMPERATURE",
            "type": "float",
            "units": "°F",
            "min": -273,
            "max": 200
        },
        {
            "name": "PRECIPITATION",
            "type": "float",
            "units": "Inches",
            "min": 0
        },
        {
            "name": "C3_PHYCOCYANIN",
            "type": "float",
            "units": "RFUB",
            "min": 0
        },
        {
            "name": "C3_FLUORESCENCE",
            "type": "float",
            "units": "RFUB",
            "min": 0
        },
        {
            "name": "C3_PHYCOCYANIN_PPB",
            "type": "float",
            "units": "ppb",
            "min": 0,
            "max": 1000000000
        }
    ]
}
